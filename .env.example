# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes encoded as base64. Used only on the server to encrypt connector tokens.
ANETO_CREDENTIAL_ENCRYPTION_KEY=

# Vercel sends this value as a Bearer token to scheduled routes.
CRON_SECRET=

# Canonical application URL used by OAuth callbacks.
ANETO_APP_URL=https://aneto-analyse.vercel.app

# Optional: protects /admin until application authentication is complete.
ANETO_ADMIN_TOKEN=

# Ausha uses a Public API token entered by an organization owner in Settings.
# It is encrypted before being stored and is never saved in this file.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
